# Copy to .env and fill in. .env is git-ignored and never served to the browser.
# Get a key at https://openrouter.ai/keys (free models cost nothing).
OPENROUTER_API_KEY=

# Optional: comma-separated models to try in order. Leave empty to auto-pick free models that support tool calling.
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-235b-a22b:free

# Optional: let other devices on your network (e.g. your phone) use the brain. Off by default.
# AETHER_ALLOW_LAN=1
